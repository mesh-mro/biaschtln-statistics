<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0-windows10.0.19041.0 (nicht nur net9.0-windows): SkiaSharp 3 / LiveCharts2
         liefert keinen Build fuer netx.0-windows ohne Min-Windows-Version. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Biaschtln.Statistics</RootNamespace>

    <!-- Assembly-Metadaten (u. a. für den Info-Dialog). -->
    <Version>1.0.0</Version>
    <Product>Biaschtln-Statistik</Product>
    <Authors>Markus Roider</Authors>
    <Company>Markus Roider</Company>
    <Copyright>Copyright © 2026 Markus Roider</Copyright>
    <Description>Auswertung von CSV-Exporten aus dem Kassensystem Biaschtln.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
