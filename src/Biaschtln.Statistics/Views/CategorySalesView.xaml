<UserControl x:Class="Biaschtln.Statistics.Views.CategorySalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:Biaschtln.Statistics.Converters"
             xmlns:models="clr-namespace:Biaschtln.Statistics.Models"
             xmlns:vm="clr-namespace:Biaschtln.Statistics.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:CategorySalesViewModel}">
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,6">
            <Button Content="Als PNG" Click="OnExportPng" Padding="8,2" Margin="0,0,6,0" />
            <Button Content="Als CSV" Command="{Binding ExportCsvCommand}" Padding="8,2" />
        </StackPanel>

        <Grid x:Name="ExportRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Donut: Umsatzanteil je Kategorie -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Umsatz nach Kategorie"
                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <lvc:PieChart Series="{Binding CategorySeries}" LegendPosition="Bottom" />
        </DockPanel>

        <!-- Balken: Top-Artikel nach Umsatz / Stückzahl -->
        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Top-Artikel" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Sortierung:" VerticalAlignment="Center"
                               Foreground="#757575" Margin="0,0,8,0" />
                    <RadioButton Content="Umsatz" GroupName="rank" Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding ArticleRanking, Converter={StaticResource EnumToBool},
                                             ConverterParameter={x:Static models:ArticleRanking.Revenue}}" />
                    <RadioButton Content="Stückzahl" GroupName="rank"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding ArticleRanking, Converter={StaticResource EnumToBool},
                                             ConverterParameter={x:Static models:ArticleRanking.Quantity}}" />
                </StackPanel>
            </Grid>
            <lvc:CartesianChart Series="{Binding ArticleSeries}"
                                XAxes="{Binding ArticleXAxes}"
                                YAxes="{Binding ArticleYAxes}" />
        </DockPanel>

        <!-- Leer-Anzeige, wenn keine (gefilterten) Daten vorliegen -->
        <TextBlock Grid.ColumnSpan="2"
                   Text="Keine Daten — bitte CSV laden oder Filter lockern."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9E9E9E" FontSize="14">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
